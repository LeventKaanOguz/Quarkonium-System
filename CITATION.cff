    given-names: "Altuğ"
  - family-names: "Oğuz"
    given-names: "Levent Kaan"
license: MIT
version: "1.0.0"
date-released: "2026-11-12"
repository-code: "https://github.com/LeventKaanOguz/Quarkonium-System"
keywords:
  - quarkonium
  - Gaussian expansion method
  - potential model
  - Godfrey-Isgur
  - model selection
  - CERN ROOT
