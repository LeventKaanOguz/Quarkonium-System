# Normalise line endings in the repository
* text=auto eol=lf

# Binary files
*.pdf binary
*.png binary
*.sqlite binary
*.root binary

# Generated by analysis/analyze.py and graphviz: committed, but hidden from
# diffs and language statistics on GitHub
docs/report/data/** linguist-generated=true
docs/report/tables.md linguist-generated=true
docs/report/figures/** linguist-generated=true
docs/figures/algorithm.svg linguist-generated=true

# The lecture notes are documentation, not code
docs/notes/*.tex linguist-documentation=true
